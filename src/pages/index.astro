---
import Base from "../layouts/Base.astro";
import NoteList from "../components/NoteList.astro";
import SearchNotes from "../components/SearchNotes.astro";
import { getNotes } from "../lib/notes";

const notes = await getNotes();
---

<Base
  title="wademartin.dev"
  description="A public notebook of ideas and experiments in DevOps, developer experience, web development, AI apps, agents and spec-driven development."
>
  <p class="lede">
    A public notebook of ideas and experiments in DevOps, developer experience, web development, AI apps, agents
    and{" "}<mark>spec-driven development</mark>.
  </p>
  <h1 class="label">Notes</h1>
  <SearchNotes />
  <NoteList notes={notes} />
</Base>
