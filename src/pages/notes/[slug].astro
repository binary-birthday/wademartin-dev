---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import { formatDate, getNotes, noteUrl, tagUrl, type Note } from "../../lib/notes";

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

interface Props {
  note: Note;
}

const { note } = Astro.props;
const { title, summary, date, updated, status, tags, superseded_by, links } = note.data;
const { Content } = await render(note);
// Short link text for the margin: drop the scheme, "www." and "github.com/".
const label = (url: string) =>
  url.replace(/^https?:\/\/(www\.)?/, "").replace(/^github\.com\//, "").replace(/\/$/, "");
---

<Base title={title} description={summary} type="article">
  <article class="note">
    <h1 class="note-title">{title}</h1>
    <dl class="note-margin">
      <div>
        <dt>Status</dt>
        <dd><StatusBadge status={status} /></dd>
      </div>
      <div>
        <dt>Published</dt>
        <dd><time datetime={date.toISOString()}>{formatDate(date)}</time></dd>
      </div>
      {updated && (
        <div>
          <dt>Updated</dt>
          <dd><time datetime={updated.toISOString()}>{formatDate(updated)}</time></dd>
        </div>
      )}
      <div>
        <dt>Tags</dt>
        <dd class="note-tags">
          {tags.map((tag) => (
            <a href={tagUrl(tag)}>{tag}</a>
          ))}
        </dd>
      </div>
      {links && links.length > 0 && (
        <div>
          <dt>Links</dt>
          <dd class="note-links">
            {links.map((link) => (
              <a href={link}>{label(link)}</a>
            ))}
          </dd>
        </div>
      )}
    </dl>
    <div class="note-body prose">
      {status === "outdated" && (
        <p class="banner">
          This note is outdated.
          {superseded_by && (
            <>
              {" "}See <a href={noteUrl(superseded_by.id)}>the newer note</a>.
            </>
          )}
        </p>
      )}
      <Content />
    </div>
  </article>
</Base>
