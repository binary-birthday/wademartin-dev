---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import { formatDate, getNotes, noteUrl, tagUrl, type Note } from "../../lib/notes";

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

interface Props {
  note: Note;
}

const { note } = Astro.props;
const { title, summary, date, updated, status, tags, superseded_by, links } = note.data;
const { Content } = await render(note);
---

<Base title={title} description={summary} type="article">
  <article>
    <header class="note-header">
      <h1>{title}</h1>
      <div class="meta">
        <span>Published <time datetime={date.toISOString()}>{formatDate(date)}</time></span>
        {updated && (
          <span>Updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time></span>
        )}
        <StatusBadge status={status} />
      </div>
    </header>
    {status === "outdated" && (
      <p class="banner">
        This note is outdated.
        {superseded_by && (
          <>
            {" "}See <a href={noteUrl(superseded_by.id)}>the newer note</a>.
          </>
        )}
      </p>
    )}
    <Content />
    <footer class="note-footer">
      {links && links.length > 0 && (
        <>
          <p class="label">Links</p>
          <ul>
            {links.map((link) => (
              <li>
                <a href={link}>{link}</a>
              </li>
            ))}
          </ul>
        </>
      )}
      <div class="meta">
        <span>Tags:</span>
        {tags.map((tag) => (
          <a href={tagUrl(tag)}>{tag}</a>
        ))}
      </div>
    </footer>
  </article>
</Base>
