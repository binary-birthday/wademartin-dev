---
import { formatDate, noteUrl, type Note } from "../lib/notes";

interface Props {
  notes: Note[];
}

const { notes } = Astro.props;
---

{notes.length === 0 ? (
  <p>No notes yet.</p>
) : (
  <ul class="note-list">
    {notes.map((note) => (
      <li>
        <a href={noteUrl(note.id)}>{note.data.title}</a>
        <div class="meta">
          <time datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time>
          {" · "}{note.data.status}
        </div>
        <div>{note.data.summary}</div>
      </li>
    ))}
  </ul>
)}
