---
import StatusBadge from "./StatusBadge.astro";
import { formatDate, noteUrl, tagUrl, type Note } from "../lib/notes";

interface Props {
  notes: Note[];
}

const { notes } = Astro.props;
---

{notes.length === 0 ? (
  <p class="intro">No notes yet.</p>
) : (
  <ul class="note-list">
    {notes.map((note) => (
      <li>
        <h2>
          <a href={noteUrl(note.id)}>{note.data.title}</a>
        </h2>
        <div class="meta">
          <time datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time>
          <StatusBadge status={note.data.status} />
          {note.data.tags.map((tag) => (
            <a href={tagUrl(tag)}>{tag}</a>
          ))}
        </div>
        <p>{note.data.summary}</p>
      </li>
    ))}
  </ul>
)}
